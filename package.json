{
  "name": "nirai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nirai repository commands; World dependencies are owned by world/package.json",
  "scripts": {
    "dev": "npm --prefix world run dev",
    "build": "npm --prefix world run build",
    "typecheck": "npm --prefix world run typecheck",
    "test": "npm --prefix world test",
    "test:core": ".venv\\Scripts\\python.exe -m pytest"
  }
}
